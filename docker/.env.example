# Variáveis de ambiente para o docker-compose de desenvolvimento
# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=uniplus
POSTGRES_PASSWORD=uniplus_dev
POSTGRES_DB=uniplus

# PostgreSQL — bancos da Sprint 3 (Configuracao + Organizacao)
# Usuários isolados, cada um dono do próprio banco. Provisionados por
# docker/init-db.sql com a senha dev fixa abaixo (init-db.sql não interpola
# env vars). As connection strings em appsettings serão adicionadas quando
# os módulos forem scaffoldados (F1.S2 / F1.S3).
CONFIGURACAO_DB_USER=uniplus_configuracao_app
CONFIGURACAO_DB_PASSWORD=uniplus_dev
ORGANIZACAO_DB_USER=uniplus_organizacao_app
ORGANIZACAO_DB_PASSWORD=uniplus_dev

# MinIO (Object Storage S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Kafka (Message Broker — KRaft)
# Gerar novo ID: docker run --rm apache/kafka:4.2.0 kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret do client M2M uniplus-api-selecao, com que a API confere o endereço no Geo.
# Só local: scripts/setup-keycloak-dev.sh cria o client com este valor (sem comentário na linha).
UNIPLUS_API_SELECAO_CLIENT_SECRET=uniplus-dev-m2m

# Geo API — imagem publicada no GHCR pelo repo unifesspa-geo-api (extraído, ADR-0099).
# O repo NÃO publica `latest`; fixar uma tag concreta. Tags publicadas: v1.0.0, v1.0.1, sha-ee1d3d6.
# v1.0.1 inclui o fix do banco de staging dedicado da DNE (unifesspa-geo-api#12).
GEO_IMAGE_TAG=v1.0.1

# gov.br como Identity Provider externo do Keycloak (ADR-029)
# Credenciais fornecidas pelo gov.br após cadastro institucional
# (https://acesso.gov.br/roteiro-tecnico). NUNCA commitar valores reais.
# Em homologação, GOVBR_CLIENT_ID = hostname do Keycloak (ex.: keycloak-hom.unifesspa.edu.br).
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_ENV=staging

# RabbitMQ — fila de trabalho da verificação dos arquivos do candidato (só local; em HML é da infraestrutura).
RABBITMQ_USER=uniplus
RABBITMQ_PASSWORD=uniplus_dev

# Instalação dos gestores de acessos pelo serviço `ambiente-init` do override (ADR-0152). `false` configura o
# Keycloak mas não instala os gestores.
INSTALAR_GESTORES=true

# Portas publicadas no host. Os valores são os padrões; troque-os aqui para rodar mais de um ambiente na mesma
# máquina, ou use `scripts/dev-up.sh --deslocamento-de-portas N`, que soma N a todas elas.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
LDAP_PORT=1389
KEYCLOAK_PORT=8080
APICURIO_PORT=8081
API_PORT=5200
GEO_API_PORT=5400
PORTAL_API_PORT=5302
OPENAPI_DOCS_PORT=5299
GATEWAY_PORT=5000
GATEWAY_DASHBOARD_PORT=5080
SELECAO_WEB_PORT=4200
INGRESSO_WEB_PORT=4201
PORTAL_WEB_PORT=4202
CONFIGURACAO_WEB_PORT=4203

# Nome do projeto do compose, para um segundo ambiente não dividir contêineres e volumes com o primeiro.
# Fica comentado de propósito: definir o nome num ambiente que já existe o renomeia e deixa os volumes atuais
# órfãos. Descomente só ao criar um ambiente novo, com portas diferentes.
# COMPOSE_PROJECT_NAME=uniplus-b
