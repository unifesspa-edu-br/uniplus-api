# Migrations e snapshot são gerados pelo `dotnet ef`: o analisador os trata como código gerado.
# O que a marca não cobre e segue o que a ferramenta emite:
# - S104: o analisador de tamanho de arquivo não respeita `generated_code`, e a migration inicial
#   não traz o cabeçalho `<auto-generated>`
# - charset: grava com BOM
# - separate_import_directive_groups: não separa grupos de using
[*.cs]
generated_code = true
dotnet_diagnostic.S104.severity = none
charset = utf-8-bom
dotnet_separate_import_directive_groups = false
