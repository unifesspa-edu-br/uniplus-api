<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- Módulos Verificador, Portal, Ingresso, Autorização e Host sem dívida de métricas: a build falha se elas voltarem a ser descumpridas. -->
    <MetricasBarradas Condition="$(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Verificador')) Or $(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Portal.')) Or $(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Ingresso.')) Or $(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Autorizacao.')) Or $(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Host')) Or $(MSBuildProjectName.StartsWith('Unifesspa.UniPlus.Monolito.'))">true</MetricasBarradas>
    <WarningsNotAsErrors Condition="'$(MetricasBarradas)' != 'true'">$(WarningsNotAsErrors);MA0051;S104;S3776;S1541;S107</WarningsNotAsErrors>
    <ErrorLog>$(MSBuildThisFileDirectory)artifacts/analise/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)SonarLint.xml" />
  </ItemGroup>

  <Target Name="CriarPastaDoRelatorioDeAnalise" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(MSBuildThisFileDirectory)artifacts/analise" />
  </Target>

  <!-- O analyzer transitivo da MR (MR.EntityFrameworkCore.KeysetPagination.Analyzers,
       ADR-0094) referencia um Roslyn (5.3) mais novo que o do SDK das imagens Docker (5.0),
       emitindo CS9057 que vira erro sob TreatWarningsAsErrors no publish. O analyzer flui
       transitivamente a TODOS os projetos que (direta ou indiretamente) referenciam a MR, e
       ExcludeAssets não o corta — então o target é global aqui (Directory.Build.props),
       removendo-o do ItemGroup Analyzer antes da compilação em qualquer projeto. Só o motor
       de runtime da MR importa; a regra de chave não-nula (ADR-0095) é garantida por design
       + testes, não pelo analyzer. -->
  <Target Name="RemoverMrKeysetAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('MR.EntityFrameworkCore.KeysetPagination'))" />
    </ItemGroup>
  </Target>
  <!-- Projeto de teste não publica documento OpenAPI: o único AddOpenApi está no Infrastructure.Core.
       O gerador de comentários XML do pacote chega aos testes pelas referências às APIs e só emitiria
       ali código de apoio sem uso. -->
  <Target Name="RemoverGeradorDeComentariosDoOpenApiDosTestes" BeforeTargets="CoreCompile"
          Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
