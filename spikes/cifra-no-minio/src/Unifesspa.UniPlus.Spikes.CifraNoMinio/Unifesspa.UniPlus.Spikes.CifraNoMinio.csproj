<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Um executável, quatro papéis escolhidos por PAPEL (ou pelo primeiro argumento "carga"):
    verificador, api-nova, api-atual e o gerador de carga das medições. Código descartável da
    POC: não entra no UniPlus.slnx nem é referenciado por produção.
  -->
  <PropertyGroup>
    <RootNamespace>Unifesspa.UniPlus.Spikes.CifraNoMinio</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Minio" />
  </ItemGroup>

</Project>
