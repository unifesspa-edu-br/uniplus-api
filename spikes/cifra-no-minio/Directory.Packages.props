<Project>

  <!--
    Ilha de pacotes da POC da cifra no MinIO (#2045). Standalone, como a do spike de Event
    Sourcing: não importa o Directory.Packages.props da raiz. O SDK do MinIO fica na mesma versão
    da produção, para que as provas de URL pré-assinada valham para o cliente que a API usa.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Minio" Version="7.0.0" />
    <!-- As mesmas versões da API: o outbox e o transporte medidos são os que a produção usaria. -->
    <PackageVersion Include="WolverineFx" Version="5.41.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="5.41.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="5.41.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="5.41.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
