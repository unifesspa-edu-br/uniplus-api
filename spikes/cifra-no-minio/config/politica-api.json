{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssinaOEnvio",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::uniplus-envios/*", "arn:aws:s3:::uniplus-envios-atual/*"]
    },
    {
      "Sid": "AssinaALeituraDoArquivoVerificado",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::uniplus-arquivos-candidato/*"]
    }
  ]
}
