{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeERemoveOEnvio",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-envios/*"
      ]
    },
    {
      "Sid": "AprovaPorEtiquetaNoProprioEnvio",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-envios/*"
      ]
    },
    {
      "Sid": "PromoveOArquivoLimpo",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-arquivos-candidato/*"
      ]
    },
    {
      "Sid": "ReconheceOArquivoJaPromovidoNaReentrega",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-arquivos-candidato/*"
      ]
    },
    {
      "Sid": "ConfereOsBucketsComoOSdkExige",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::uniplus-envios",
        "arn:aws:s3:::uniplus-arquivos-candidato"
      ]
    }
  ]
}
