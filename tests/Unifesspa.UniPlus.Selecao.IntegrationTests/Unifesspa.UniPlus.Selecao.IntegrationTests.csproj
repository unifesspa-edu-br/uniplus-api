  <!--
    Golden fixtures do envelope canônico (ADR-0109), comparadas byte a byte. São
    a forma corrente em três corpus — base, com cascata e rica —, não uma por
    schema_version: o codec é único e reescrito no lugar. A versão que elas
    congelam é declarada em schema-version.txt, ao lado. É o único gate de
    regressão do congelamento — a baseline OpenAPI não o enxerga (o DTO expõe a
    configuração como JsonNode).
  -->
  <ItemGroup>
    <Content Include="ProcessosSeletivos/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ProcessosSeletivos/Fixtures/schema-version.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <ItemGroup>
    <!-- Instantes construídos a partir da zona institucional resolvida (issue #1376). Compilado em
         cada projeto que precisa, em vez de copiado: três cópias divergiriam na primeira correção. -->
    <Compile Include="../Shared/InstanteEmBelem.cs" Link="InstanteEmBelem.cs" />
