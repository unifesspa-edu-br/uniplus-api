<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Unifesspa.UniPlus.Kernel.EnumsDefeituososDeTeste/Unifesspa.UniPlus.Kernel.EnumsDefeituososDeTeste.csproj" />
    <ProjectReference Include="..\..\src\shared\Unifesspa.UniPlus.Infrastructure.Core\Unifesspa.UniPlus.Infrastructure.Core.csproj" />
  </ItemGroup>

  <!-- Schemas Avro embedded usados por SchemaRegistrationHostedServiceTests (#362) -->
  <ItemGroup>
    <EmbeddedResource Include="Messaging\SchemaRegistry\Resources\*.avsc" />
    <EmbeddedResource Include="Messaging\SchemaRegistry\Resources\*.schema.json" />
  </ItemGroup>

  <!-- Tabela de mapeamentos que o registro das regras precisa expor (RegrasDomainErrorRegistrationTests) -->
  <ItemGroup>
    <None Include="Errors\RegrasMapeamentosEsperados.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Esquema versionado da configuração do processo seletivo e os exemplos, conferidos pelo teste de contrato. -->
  <ItemGroup>
    <None Include="..\..\contracts\selecao\configuracao\**\*.json" Link="Contratos\selecao-configuracao\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- O baseline da OpenAPI do módulo Seleção, onde o esquema do documento é publicado como componentes. -->
    <None Include="..\..\contracts\openapi.selecao.json" Link="Contratos\openapi.selecao.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/DecisaoDeAcessoDeTeste.cs" Link="DecisaoDeAcessoDeTeste.cs" />
    <Compile Include="../Shared/EnumsDeCodigoDeContratoDeTeste.cs" Link="EnumsDeCodigoDeContratoDeTeste.cs" />
    <Compile Include="../Shared/SondaDeInicioDoHost.cs" Link="SondaDeInicioDoHost.cs" />
    <Compile Include="../Shared/RegraDeNomeDeTabela.cs" Link="RegraDeNomeDeTabela.cs" />
    <Compile Include="../Shared/RegraDeTamanhoDeIdentificador.cs" Link="RegraDeTamanhoDeIdentificador.cs" />
    <Compile Include="../Shared/RelogioFixo.cs" Link="RelogioFixo.cs" />
    <Compile Include="../Shared/SerializacaoDosCodigosNasMensagensTestsBase.cs" Link="SerializacaoDosCodigosNasMensagensTestsBase.cs" />
    <Compile Include="../Unifesspa.UniPlus.IntegrationTests.Fixtures/Observability/ColetorDeMedidas.cs" Link="Apoio/ColetorDeMedidas.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
