{
  "openapi": "3.1.1",
  "info": {
    "title": "Uni\u002B \u2014 M\u00F3dulo Ingresso",
    "description": "API REST do Sistema Unificado Unifesspa (Uni\u002B). Contrato can\u00F4nico V1 \u2014 ProblemDetails RFC 9457, pagina\u00E7\u00E3o cursor opaco, vendor MIME versioning. Toda string user-facing em pt-BR (ADR-0022).",
    "contact": {
      "name": "CTIC Unifesspa",
      "url": "https://developers.uniplus.unifesspa.edu.br",
      "email": "ctic@unifesspa.edu.br"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.uniplus.unifesspa.edu.br",
      "description": "Produ\u00E7\u00E3o"
    },
    {
      "url": "https://api.hml.uniplus.unifesspa.edu.br",
      "description": "Homologa\u00E7\u00E3o"
    }
  ],
  "paths": {
    "/api/profile/me": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Retorna o perfil do usu\u00E1rio autenticado",
        "description": "Retorna a identidade do access token (nome, e-mail, CPF, NomeSocial) e os perfis de acesso que a pessoa tem por concess\u00E3o vigente, cada um com o escopo (unidade ou institui\u00E7\u00E3o) e o prazo. O token identifica a pessoa e n\u00E3o concede acesso. Requer autentica\u00E7\u00E3o.",
        "operationId": "ConsultarUsuarioAutenticado",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PerfilConcedidoResponse": {
        "required": [
          "concessaoId",
          "perfilId",
          "nome",
          "escopoTipo",
          "unidadeId",
          "unidadeSigla",
          "unidadeNome",
          "validaAte"
        ],
        "type": "object",
        "properties": {
          "concessaoId": {
            "type": "string",
            "format": "uuid"
          },
          "perfilId": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "escopoTipo": {
            "type": "string"
          },
          "unidadeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "unidadeSigla": {
            "type": [
              "null",
              "string"
            ]
          },
          "unidadeNome": {
            "type": [
              "null",
              "string"
            ]
          },
          "validaAte": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "retryable": {
            "type": "boolean",
            "description": "Presente e \u0060true\u0060 quando o conflito descreve uma corrida que j\u00E1 passou: a mesma requisi\u00E7\u00E3o, repetida sem altera\u00E7\u00E3o, pode agora ser aceita. A aus\u00EAncia \u00E9 o default conservador do servidor \u2014 diz que o conflito n\u00E3o foi declarado retent\u00E1vel, n\u00E3o que repetir esteja descartado; nesse caso vale a descri\u00E7\u00E3o da pr\u00F3pria resposta."
          },
          "errors": {
            "type": "array",
            "items": {
              "required": [
                "code",
                "message"
              ],
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "O campo que a viola\u00E7\u00E3o aponta, em nota\u00E7\u00E3o de pontos e colchetes ou como ponteiro JSON quando o corpo \u00E9 um documento. Ausente quando a viola\u00E7\u00E3o n\u00E3o \u00E9 de campo."
                },
                "code": {
                  "type": "string",
                  "description": "O c\u00F3digo publicado do erro."
                },
                "message": {
                  "type": "string",
                  "description": "A mensagem do erro, que nunca repete o valor recusado."
                },
                "identificadores": {
                  "type": "array",
                  "items": {
                    "required": [
                      "lista",
                      "identificador"
                    ],
                    "type": "object",
                    "properties": {
                      "lista": {
                        "type": "string",
                        "description": "O nome da lista, como aparece no caminho do campo."
                      },
                      "identificador": {
                        "type": "string",
                        "description": "O identificador est\u00E1vel do item: um c\u00F3digo de cat\u00E1logo ou um identificador opaco, nunca dado pessoal."
                      }
                    }
                  },
                  "description": "O identificador est\u00E1vel de cada item de lista que o campo atravessa, na ordem do caminho, para achar o item mesmo depois de outra grava\u00E7\u00E3o mudar as posi\u00E7\u00F5es. Ausente quando a viola\u00E7\u00E3o n\u00E3o aponta item com identificador; o identificador que j\u00E1 n\u00E3o existe n\u00E3o aponta outro item."
                }
              }
            },
            "description": "Uma entrada por viola\u00E7\u00E3o, quando a resposta re\u00FAne mais de uma ou quando alguma aponta um campo. A primeira \u00E9 a que descreve a resposta inteira."
          }
        }
      },
      "UserProfileResponse": {
        "required": [
          "userId",
          "name",
          "email",
          "cpf",
          "nomeSocial",
          "perfis",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "cpf": {
            "pattern": "^\\d{11}$",
            "type": [
              "null",
              "string"
            ],
            "description": "CPF (apenas d\u00EDgitos, sem formata\u00E7\u00E3o). PII \u2014 sempre mascarar em logs (\u0027***.999.999-**\u0027, ADR-0011)."
          },
          "nomeSocial": {
            "type": [
              "null",
              "string"
            ]
          },
          "perfis": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PerfilConcedidoResponse"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Token JWT emitido pelo provedor de identidade institucional (Keycloak). Cole apenas o token: o prefixo \u0022Bearer\u0022 \u00E9 acrescentado ao cabe\u00E7alho Authorization automaticamente. As rotas administrativas exigem, al\u00E9m da autentica\u00E7\u00E3o, a role plataforma-admin no token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Profile"
    }
  ]
}
