root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# Organização de usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Preferências de tipo
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning

# Namespace
csharp_style_namespace_declarations = file_scoped:warning

# Nullable
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error

# Análise estática — política registrada na ADR-0117 (AnalysisLevel=latest-recommended
# com opt-in/opt-out nomeado). Regras abaixo são decisões, não exceções pontuais.

# CA1000: Result<T> usa factory methods estáticos (Success/Failure) por design — padrão
# consagrado do Result pattern, praticado pela própria BCL (EqualityComparer<T>.Default,
# ImmutableArray<T>.Empty). A regra mira adoção de bibliotecas públicas; não se aplica ao
# Kernel interno. Desligada globalmente em vez de suprimida caso a caso.
dotnet_diagnostic.CA1000.severity = none

# CA1062: null-check em argumento de método público. O latest-recommended não a liga por
# padrão, mas o código já a satisfaz (ArgumentNullException.ThrowIfNull é convenção do
# projeto). Religada via opt-in para preservar a proteção de null-safety que o latest-all
# dava — decisão consciente, não herança automática.
dotnet_diagnostic.CA1062.severity = warning

# Naming conventions — ordem importa: Roslyn aplica a primeira regra que casa,
# então constantes e static readonly precisam vir ANTES da regra geral de
# private_fields, senão IDE1006 marca `const Foo` como violação por não ter
# prefixo `_`. Convenção .NET (BCL, runtime, MS guidelines):
#   - const                → PascalCase
#   - static readonly      → PascalCase
#   - private field        → _camelCase
#   - private static field → _camelCase (regra geral; sem distinção especial)

# Constantes em qualquer accessibility → PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# Static readonly em qualquer accessibility → PascalCase
dotnet_naming_rule.static_readonly_should_be_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_should_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_should_be_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Private fields (instance): _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore_prefix.required_prefix = _
dotnet_naming_style.camel_case_underscore_prefix.capitalization = camel_case

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Métricas de qualidade: limites em SonarLint.xml. Avisam até o fim da refatoração.
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S1541.severity = warning
dotnet_diagnostic.S107.severity = warning

# Dono único de cada regra. O aviso de tamanho de método é da S138, sinal auxiliar: a medida é a
# contagem física do CONTRIBUTING.md, seção "Métricas de qualidade". Estas têm dono na análise do .NET:
# CA2007 (ConfigureAwait), CA1822 (membro que pode ser estático), CA2200 (relançar exceção),
# CA1825 (array vazio), CA1018 (AttributeUsage), CA1050 (tipo fora de namespace),
# CA2201 (exceção reservada), CA1041 (Obsolete sem mensagem), CA1067 (Equals de IEquatable),
# CA2211 (campo estático visível).
dotnet_diagnostic.CA2007.severity = warning
# CA1000 (membro estático em tipo genérico) está desligada por decisão, e a duplicata sai junto.
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0027.severity = none
dotnet_diagnostic.MA0005.severity = none
dotnet_diagnostic.MA0010.severity = none
dotnet_diagnostic.MA0047.severity = none
dotnet_diagnostic.MA0012.severity = none
dotnet_diagnostic.MA0070.severity = none
dotnet_diagnostic.MA0095.severity = none
dotnet_diagnostic.MA0069.severity = none
# Comportamento fica com o Meziantou ou com a análise do .NET, não com o Roslynator:
# MA0064 (lock), MA0081 (params), MA0022 (Task nula), CA1862 (comparação de texto), CA2200, CA1018.
dotnet_diagnostic.RCS1059.severity = none
dotnet_diagnostic.RCS1193.severity = none
dotnet_diagnostic.RCS1210.severity = none
dotnet_diagnostic.RCS1155.severity = none
dotnet_diagnostic.RCS1044.severity = none
dotnet_diagnostic.RCS1203.severity = none

# Regras do Meziantou com ocorrências no código: sugestão enquanto são corrigidas.
# Ao zerar uma regra, retirá-la daqui para que volte a barrar a build.
dotnet_diagnostic.MA0002.severity = suggestion
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0008.severity = suggestion
dotnet_diagnostic.MA0009.severity = suggestion
dotnet_diagnostic.MA0011.severity = suggestion
dotnet_diagnostic.MA0016.severity = suggestion
dotnet_diagnostic.MA0023.severity = suggestion
dotnet_diagnostic.MA0026.severity = suggestion
dotnet_diagnostic.MA0048.severity = suggestion
dotnet_diagnostic.MA0084.severity = suggestion
dotnet_diagnostic.MA0244.severity = suggestion

# Roslynator é sugestão na IDE, nunca barra a build. As demais regras dele já nascem abaixo
# de aviso; aqui ficam as que nascem como aviso.
dotnet_diagnostic.RCS1075.severity = suggestion
dotnet_diagnostic.RCS1102.severity = suggestion
dotnet_diagnostic.RCS1138.severity = suggestion
dotnet_diagnostic.RCS1139.severity = suggestion
dotnet_diagnostic.RCS1172.severity = suggestion
dotnet_diagnostic.RCS1194.severity = suggestion
dotnet_diagnostic.RCS1215.severity = suggestion
dotnet_diagnostic.RCS1242.severity = suggestion
dotnet_diagnostic.RCS1263.severity = suggestion

[*.md]
trim_trailing_whitespace = false

# Camada API (hosts ASP.NET Core) — não possui SynchronizationContext, ConfigureAwait(false)
# é no-op. Library code em Infrastructure.Core mantém ConfigureAwait(false) e CA2007 ativo.
[src/**/*.API/**.cs]
dotnet_diagnostic.CA2007.severity = none

# Controllers e Middleware internos são instanciados via reflexão pelo framework
# (routing MVC, app.UseMiddleware<T>). CA1812 não detecta essa instanciação.
[src/**/*.API/{Controllers,Middleware}/**.cs]
dotnet_diagnostic.CA1812.severity = none

# Projetos de teste — convenções xUnit:
# - CA1707: nomes de métodos com underscores (Fato_QuandoCondicao_DeveProduzirResultado)
# - CA2007: xUnit não usa SynchronizationContext; ConfigureAwait é desnecessário
# - CA1861: literais de array em assertions priorizam legibilidade; não é hot path
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none

# Mapeamento do EF é lista declarativa de propriedades: dividi-la só para caber em tamanho de
# método seria artificial. Mapeamento longo se divide por assunto; quem cobra é a revisão.
[{src/**/Persistence/Configurations/**.cs,src/shared/Unifesspa.UniPlus.Infrastructure.Core/Idempotency/IdempotencyEntryConfiguration.cs,src/shared/Unifesspa.UniPlus.Infrastructure.Core/Persistence/EnderecoGeoOwnedConfiguration.cs}]
dotnet_diagnostic.S138.severity = none

# Migrations EF Core são auto-geradas pelo tool — analyzers que cobram
# defensive coding, perf de array literal ou estilo C# moderno não se aplicam:
# - CA1062: tool não emite ArgumentNullException no migrationBuilder
# - CA1861: tool emite arrays inline (`new[] { ... }`) em CreateIndex
# - IDE0161: tool emite namespace-block clássico, não file-scoped
# - S138, S3776, S1541, S107: tamanho e complexidade de Up/Down vêm do modelo, não de quem escreve
#
# Pelo mesmo motivo, duas regras de formatação seguem o que o `dotnet ef`
# emite, em vez de exigir retrabalho manual a cada migration gerada:
# - charset: o tool grava com BOM
# - separate_import_directive_groups: o tool não separa grupos de using
[src/**/Migrations/**.cs]
dotnet_diagnostic.S138.severity = none
dotnet_diagnostic.S3776.severity = none
dotnet_diagnostic.S1541.severity = none
dotnet_diagnostic.S107.severity = none
charset = utf-8-bom
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0161.severity = none
